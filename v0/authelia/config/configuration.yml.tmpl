server:
  address: 'tcp://127.0.0.1:9091'

log:
  level: info

identity_validation:
  reset_password:
    jwt_secret: ${AUTHELIA_JWT_SECRET}

authentication_backend:
  file:
    path: '${NEXUS_VOLUME_CONFIG}/users_database.yml'

session:
  secret: ${AUTHELIA_SESSION_SECRET}
  inactivity: '12h'
  expiration: '24h'
  remember_me: '30d'
  redis:
    host: '127.0.0.1'
    port: 6379
  cookies:
    - domain: '${AUTHELIA_COOKIE_DOMAIN}'
      authelia_url: 'https://${AUTHELIA_SUBDOMAIN}.${AUTHELIA_COOKIE_DOMAIN}'

storage:
  encryption_key: ${AUTHELIA_STORAGE_ENCRYPTION_KEY}
  local:
    path: '${NEXUS_VOLUME_DATA}/db.sqlite3'

notifier:
  filesystem:
    filename: '${NEXUS_VOLUME_DATA}/notify.txt'

# Fine-grained per-domain rules are deliberately NOT templated here — each
# deployment's protected domains/policies differ. Add your own rules directly to
# the rendered $NEXUS_VOLUME_CONFIG/configuration.yml after first deploy. This one
# blanket rule is the safe-by-default seed: Authelia rejects `default_policy: deny`
# outright when `rules` is empty (it requires at least one rule in that case), so
# an empty list isn't a valid "locked down until configured" state here — this
# wildcard rule is the closest equivalent: everything under the cookie domain
# requires at least one factor until you add narrower rules.
access_control:
  default_policy: deny
  rules:
    - domain: '*.${AUTHELIA_COOKIE_DOMAIN}'
      policy: one_factor
